# Placeholder only. Do not put real credentials in this file.
# Render supplies PORT in production.
PORT=3001

# Set production to enable secure Session cookies and the built-client server.
# NODE_ENV=development

# Exact browser origin allowed to make API mutations.
APP_ORIGIN=http://localhost:5173

# Server-only PostgreSQL connection for migrations and Phase 5 persistence.
# DATABASE_URL=postgresql://goraku:goraku_dev@localhost:5432/goraku

# Email verification and password recovery. Keep API keys server-side only.
# EMAIL_DELIVERY_MODE=console
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=verified-sender@example.com
# BREVO_SENDER_NAME=Goraku Base
# Add comma-separated throwaway domains to the built-in disposable-email blocklist.
# DISPOSABLE_EMAIL_DOMAINS=

# Server-only MyAnimeList client ID for primary Anime search and Discovery.
# MAL_CLIENT_ID=

# Optional server-only TMDB API Read Access Token for movie and TV search.
# TMDB_ACCESS_TOKEN=
# Optional server-only TMDB image base URL; the default is shown below.
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional server-only TheGamesDB API key for primary game search and the games lane in Combined Search.
# TheGamesDB requires an account login to view the key: https://api.thegamesdb.net/key.php
# THEGAMESDB_API_KEY=

# Optional server-only RAWG API key used for game Discovery, filters, and recommendations,
# and as the availability fallback when TheGamesDB search is unavailable.
# RAWG_API_KEY=

# Public media Application Rate Limit (defaults are 60/minute and burst 10).
# MEDIA_RATE_LIMIT_PER_MINUTE=60
# MEDIA_RATE_LIMIT_BURST=10

# Forwarded client addresses are ignored unless this is explicitly configured.
# Set this to true when the API is behind Render's trusted proxy.
# TRUST_PROXY=false
