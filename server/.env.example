# Placeholder only. Do not put real credentials in this file.
PORT=3001

# Exact browser origin allowed to make API mutations.
APP_ORIGIN=http://localhost:5173

# Server-only PostgreSQL connection for migrations and Phase 5 persistence.
# DATABASE_URL=postgresql://goraku:goraku_dev@localhost:5432/goraku

# Optional server-only MyAnimeList client ID for the availability fallback.
# MAL_CLIENT_ID=

# Optional server-only TMDB API Read Access Token for movie and TV search.
# TMDB_ACCESS_TOKEN=
# Optional server-only TMDB image base URL; the default is shown below.
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional server-only TheGamesDB API key for primary game search and the games lane in Combined Search.
# TheGamesDB requires an account login to view the key: https://api.thegamesdb.net/key.php
# THEGAMESDB_API_KEY=

# Optional server-only RAWG API key used when TheGamesDB is unavailable.
# RAWG_API_KEY=
