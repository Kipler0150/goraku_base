# Express listens on this port.
PORT=3001

# Exact browser origin allowed to make API mutations.
APP_ORIGIN=http://localhost:5173

# Server-only PostgreSQL connection used by `npm run db:migrate` and Phase 5 persistence.
# DATABASE_URL=postgresql://goraku:goraku_dev@localhost:5432/goraku

# Docker Compose PostgreSQL defaults (server-only; do not add these to client/.env*).
# POSTGRES_DB=goraku
# POSTGRES_USER=goraku
# POSTGRES_PASSWORD=goraku_dev

# Optional: enables the server-side MyAnimeList fallback when AniList is unavailable.
# AniList needs no credential for this read-only search slice.
# MAL_CLIENT_ID=

# Optional server-only TMDB API Read Access Token for movie and TV search.
# TMDB_ACCESS_TOKEN=
# Optional server-only TMDB image base URL; the default is shown below.
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Optional server-only TheGamesDB API key for primary game search and the games lane in Combined Search.
# TheGamesDB requires an account login to view the key: https://api.thegamesdb.net/key.php
# THEGAMESDB_API_KEY=

# Optional server-only RAWG API key used when TheGamesDB is unavailable.
# RAWG_API_KEY=

# Optional Vite proxy target for native or container development.
VITE_API_PROXY_TARGET=http://localhost:3001
